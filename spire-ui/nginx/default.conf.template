# The single origin.
#
# ADR-022 scopes each service's session cookie to its own URL path, so one service can never receive
# another's credential. Cookies scope by host AND path, which only isolates anything while all four
# services answer on ONE origin. In dev that origin is the Vite proxy (spire-ui/vite.config.ts); in a
# packaged run it is this file. The routing below is a security control, not a convenience.
#
# Substituted at container start by the nginx image's entrypoint. NGINX_ENVSUBST_FILTER restricts it
# to SPIRE_-prefixed names, so nginx's own $host, $scheme and $http_* survive untouched.

# Never clobber an upstream TLS terminator. Behind a Kubernetes Ingress that terminates TLS and
# forwards over http, $scheme here is "http": deriving X-Forwarded-Proto from it would overwrite the
# controller's "https", and the services (which trust forwarded headers in prod) would then mint an
# http:// redirect_uri and drop the session cookie's Secure attribute. That breaks ONLY behind TLS,
# so a plaintext compose check would pass clean — the verified-locally-broken-in-cluster failure.
map $http_x_forwarded_proto $spire_fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Connection is a per-request answer, never a literal. The upgrade pair is set on the server block
# (see below), so a literal "upgrade" there would be sent on EVERY request — /webhooks and /wk
# included, which never upgrade and would be told to switch protocols for nothing.
map $http_upgrade $spire_conn {
    default upgrade;
    ''      close;
}

# The public origin, pinned.
#
# This is the default server, so nginx accepts ANY Host, forwards it, and the services — which honour
# X-Forwarded-Host in prod — build redirect_uri from it. The only thing then rejecting a spoofed Host
# is the realm's registered-URI list. That list is exact-match in the shipped realm, but one operator
# writing the common https://*.example.com/* shortcut turns a spoofed Host into an authorization code
# delivered to an attacker's origin, which is an operator session.
#
# SPIRE_PUBLIC_HOST is that origin's host[:port] exactly as the browser addresses it. A request whose
# Host does not match it is not rejected — it is proxied with the PINNED host instead, so nothing
# that legitimately reaches this port under another name breaks: a Kubernetes probe addressing the
# pod IP, a compose stack reached over the LAN, an operator on localhost. Rejecting would have broken
# all three to close the same sink, and would have taken the container's own health check with it.
#
# Empty is the default and means unpinned — every deploy artifact here relies on that, because none
# of them can know the name an operator will use. Matching is exact and case-insensitive rather than
# a regex: a regex needs its dots escaped to be a pin at all (spire.example.com otherwise matches
# spireXexampleXcom), and the escaped form is then what gets forwarded on the mismatch path, which is
# not a hostname. The two maps are one decision: the first names the pin and blanks it on a match,
# the second reads that blank as "forward what the browser sent".
map $http_host $spire_pinned_host {
    default                "${SPIRE_PUBLIC_HOST}";
    "${SPIRE_PUBLIC_HOST}" "";
}
map $spire_pinned_host $spire_host {
    default $spire_pinned_host;
    ''      $http_host;
}

server {
    listen 8080;
    server_name _;

    # Resolve upstreams at REQUEST time, not at startup.
    #
    # With a literal hostname in proxy_pass, nginx resolves it while parsing the config and refuses to
    # start at all if it does not yet resolve ("host not found in upstream") — so the dashboard would
    # crash-loop whenever it started before its siblings, and would hold a stale address if a Service
    # were recreated. Assigning the upstream to a variable defers resolution to each request; because
    # the value carries no path component, the original request URI is still passed through unchanged.
    #
    # NGINX_LOCAL_RESOLVERS is derived from /etc/resolv.conf by the image's own entrypoint, so this is
    # correct for Docker's embedded DNS and for cluster DNS without being told which one it is.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    set $spire_orchestrator ${SPIRE_ORCHESTRATOR_URL};
    set $spire_gateway      ${SPIRE_GATEWAY_URL};
    set $spire_worker       ${SPIRE_WORKER_URL};

    # An SCM webhook body for a large pull request.
    client_max_body_size 25m;

    # EVERY proxied header lives here, and NO location below sets one of its own.
    #
    # That is the rule, not a formatting preference: nginx inherits proxy_set_header from an outer
    # level ONLY when the inner level defines none. A single proxy_set_header inside a location
    # therefore discards all six of these at once — which is exactly what shipped. The two socket
    # locations set Upgrade/Connection, so Host fell back to $proxy_host, the upstream NAME, OIDC
    # built redirect_uri as http://orchestrator:8080/... which no realm can match, and neither
    # X-Forwarded-Proto nor -For reached the service at all. Re-stating the list inside each location
    # fixes that but leaves the trap armed for the next one; setting nothing per location disarms it.
    # tests/render.sh asserts both halves — these values here, and no proxy_set_header below.
    #
    # Host carries the ORIGIN THE BROWSER USED, with its port: OIDC derives redirect_uri from it, so
    # $host (which drops the port) would produce a callback no realm entry matches on any port but
    # 80, and $proxy_host would send the login round-trip to a backend. vite.config.ts documents the
    # same trap. $spire_host is that Host, pinned to SPIRE_PUBLIC_HOST when one is set — map above.
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $spire_conn;
    proxy_set_header Host              $spire_host;
    proxy_set_header X-Forwarded-Host  $spire_host;
    proxy_set_header X-Forwarded-Proto $spire_fwd_proto;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

    # The OIDC callback returns the operator session as several large Set-Cookie headers --
    # Quarkus chunks the encrypted JWT, and a Keycloak token carrying roles does not fit one
    # cookie. nginx buffers a response's headers before forwarding them, and its 4k/8k default
    # is smaller than that, so the callback failed with "upstream sent too big header" and the
    # browser saw a bare 502 on /api/auth/callback while the service itself logged nothing at
    # all -- it had answered correctly. Sized for the chunked session, not measured from one
    # deployment: a realm with more roles produces a larger cookie.
    proxy_buffer_size       16k;
    proxy_buffers         8 16k;
    proxy_busy_buffers_size 32k;

    # The same session on the way back, and the same silence if it does not fit. A browser
    # concatenates every q_session_chunk_* cookie into ONE Cookie: request header, so the session
    # sized above returns on a line the 4k/8k default caps at 8k -- nginx then answers a bare 400
    # before the request reaches any service, and the service logs nothing because it never saw it.
    # Both directions have to be raised together or the fix only holds on one of them.
    large_client_header_buffers 4 32k;

    # SCM ingress. MUST precede the SPA fallback: a delivery that fell through to try_files would be
    # answered 200 with index.html, so the SCM records a successful delivery, never retries, and the
    # review is lost with nothing logged anywhere. The gateway's own policy makes /webhooks/* public
    # because an SCM presents an HMAC signature rather than a session.
    location /webhooks {
        proxy_pass $spire_gateway;
    }

    # The orchestrator owns /api, its three WebSockets included — they live under /api/ws/* so one
    # prefix, one cookie-path and one policy rule cover the whole service.
    location /api {
        proxy_pass $spire_orchestrator;
        # nginx defaults to 60s, which would cut the idle timeline and attention sockets and produce
        # reconnect churn the dashboard reports as an outage.
        proxy_read_timeout 3600s;
    }

    # The gateway owns /gw — its webhook-repo registry API and its attention socket.
    location /gw {
        proxy_pass $spire_gateway;
        proxy_read_timeout 3600s;
    }

    # The worker owns /wk — a review's assembled context, which only it can address.
    location /wk {
        proxy_pass $spire_worker;
    }

    # Health of the proxy itself, not of anything behind it.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # The dashboard is a client-routed SPA and must sit at the origin ROOT: every redirect target in
    # the services is "/" and the three cookie paths are absolute.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
