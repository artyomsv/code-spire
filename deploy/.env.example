# ---------------------------------------------------------------------------
# Packaged deployment contract. Copy to .env and fill in.
#
# Every value here is required and has NO default: a missing one stops the
# stack, naming the variable, rather than starting something subtly wrong. The
# one exception is SPIRE_PUBLIC_HOST at the bottom, which is hardening rather
# than wiring and says so.
# Never put an inline "# comment" after a value — some parsers fold it in.
#
# THIS STACK SHIPS NO TLS. Session cookies travel in plaintext and are
# sniffable and replayable. Bind it to localhost, or put a TLS terminator in
# front of the dashboard. Authentication stops casual access; it does not stop
# an on-path attacker.
# ---------------------------------------------------------------------------

# --- Host ports (the 30000-49999 range; 347xx for the packaged stack) ---
SPIRE_UI_PORT=34700
SPIRE_KEYCLOAK_PORT=34767

# --- Postgres ---
POSTGRES_DB=spire
POSTGRES_USER=spire
POSTGRES_PASSWORD=CHANGE_ME
# A second, schema-scoped role for the gateway. It owns ONLY the `gateway` schema — its webhook
# registry — and is never granted the `orchestrator` schema, so a compromised internet-facing edge
# can verify webhook signatures but cannot read the encrypted SCM/LLM token registry or the event
# store. Provisioned by infra/postgres-init on a FRESH volume; on an existing one run, as superuser:
#   CREATE ROLE "gateway" LOGIN PASSWORD '<GATEWAY_POSTGRES_PASSWORD>';
#   CREATE SCHEMA IF NOT EXISTS gateway AUTHORIZATION "gateway";
GATEWAY_POSTGRES_USER=gateway
GATEWAY_POSTGRES_PASSWORD=CHANGE_ME

# --- Encryption at rest (Tink AES-256-GCM), base64 keysets ---
# Generate your own; never reuse a value from any example.
#
# TWO SEPARATE keysets, and the separation is the point: the gateway holds only the webhook one, so
# it can decrypt webhook secrets and nothing else.
#
# NEVER let a deployment tool generate these. They decrypt data already at rest, so a regenerated
# keyset makes every encrypted event payload, provider secret and assembled context permanently
# unreadable. This is why the Helm chart takes Secret names and never mints a value.
SPIRE_ENCRYPTION_KEYSET=REPLACE_ME
SPIRE_ENCRYPTION_WEBHOOK_KEYSET=REPLACE_ME

# --- Operator authentication ---
# This stack bundles Keycloak and imports deploy/keycloak/realm-spire.json, which defines the three
# clients, their audience mappers, both roles and two obviously-synthetic dev users.
#
# To use an identity provider you already run, point this at it and remove the keycloak service. The
# issuer must be reachable under the SAME name from the browser AND from the containers, or the
# browser's issuer and the services' issuer disagree and every token fails validation.
SPIRE_OIDC_AUTH_SERVER_URL=http://host.docker.internal:34767/realms/spire
# Distinct per service. Each service is its own OIDC client so a session minted for one cannot be
# replayed against another; one shared secret ends that isolation without failing anything visible.
SPIRE_OIDC_ORCHESTRATOR_SECRET=CHANGE_ME
SPIRE_OIDC_GATEWAY_SECRET=CHANGE_ME
SPIRE_OIDC_WORKER_SECRET=CHANGE_ME

# Bundled Keycloak's own admin. Administers the local identity provider and nothing else.
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Trusted proxy ---
# The network the dashboard container runs on. The services believe X-Forwarded-For and -Proto in
# prod, so without this they would believe them from ANY source that can reach their port — and they
# refuse to start rather than run that way. Docker's default bridge pool is 172.16.0.0/12.
# A zero-length prefix (0.0.0.0/0, ::/0) is refused too, and for the same reason as an empty value:
# it names everyone, so it is not an answer to the question "who may be believed".
SPIRE_TRUSTED_PROXIES=172.16.0.0/12

# --- Public origin (the one OPTIONAL value here) ---
# The host[:port] operators type in the browser, e.g. spire.example.com or localhost:34700. The
# services build the OIDC redirect_uri from the Host header, and the dashboard proxy answers to any
# Host, so a request carrying a forged one produces a login redirect pointing at the forger's origin.
# The realm's registered-URI list is the only other thing rejecting it — which holds while those
# entries are exact hosts, and stops holding the moment one of them is a wildcard.
#
# Set this and the proxy forwards this value instead of whatever was sent. Left empty it forwards the
# request's own Host, which is the behaviour of every deployment before this variable existed and the
# reason it is the default: nothing here can know the name you will use.
SPIRE_PUBLIC_HOST=

# --- Image tag ---
# `edge` tracks master. Pin a release (e.g. 0.2.0) for a deployment you intend to keep.
SPIRE_VERSION=edge

# ---------------------------------------------------------------------------
# e2e overlay (deploy/compose.e2e.yml) ONLY. Ignored by a plain packaged run.
#
# The overlay declares its own compose project (`spire-e2e`) so it never adopts
# a packaged stack you already have running, which also means its host ports
# must not collide with that stack's 347xx block. Hence 348xx.
#
# Every value is obviously synthetic: this GitLab is created, used and deleted
# by the test suite and holds nothing real.
# ---------------------------------------------------------------------------
# The 348xx block. An e2e run declares its OWN compose project, so it can coexist with a packaged
# stack — but only if it also moves the two ports the base compose file publishes. Copying this file
# and running the overlay with SPIRE_UI_PORT=34700 clashes with any packaged stack already bound
# there, and then StackHealthTest reports the dashboard unreachable on 34800 while it is running
# perfectly on 34700 — a failure that points at the wrong component.
SPIRE_UI_PORT=34800
SPIRE_KEYCLOAK_PORT=34867
E2E_GITLAB_ROOT_PASSWORD=TEST-gitlab-root-password
E2E_GITLAB_PORT=34880
E2E_LLM_MOCK_PORT=34881

# The realm's own operator. deploy/keycloak/realm-spire.json hardcodes the
# username dev-operator and this password; the variable exists so the harness
# and deploy/e2e.sh read it from one place rather than hardcoding it twice.
DEV_OPERATOR_PASSWORD=dev-operator
DEV_VIEWER_PASSWORD=dev-viewer
