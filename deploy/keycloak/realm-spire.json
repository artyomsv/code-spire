{
  "realm": "spire",
  "enabled": true,
  "displayName": "Code Spire (dev)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "spire-viewer",
        "description": "Read the dashboard"
      },
      {
        "name": "spire-admin",
        "description": "Manage configuration, replay, prompts"
      }
    ]
  },
  "users": [
    {
      "username": "dev-operator",
      "email": "dev-operator@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "DEV",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "dev-operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "spire-admin",
        "spire-viewer"
      ]
    },
    {
      "username": "dev-viewer",
      "email": "dev-viewer@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "DEV",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "dev-viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "spire-viewer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "spire-orchestrator",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-orchestrator-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:34000/api/auth/callback",
        "http://localhost:39285/api/auth/callback",
        "http://localhost:34080/api/auth/callback",
        "http://localhost:39280/api/auth/callback",
        "http://localhost:34700/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:34000",
        "http://localhost:39285",
        "http://localhost:34700"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:34000/*##http://localhost:39285/*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "spire-orchestrator",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email",
        "acr"
      ]
    },
    {
      "clientId": "spire-gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-gateway-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:34000/gw/auth/callback",
        "http://localhost:39285/gw/auth/callback",
        "http://localhost:34081/gw/auth/callback",
        "http://localhost:39281/gw/auth/callback",
        "http://localhost:34700/gw/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:34000",
        "http://localhost:39285",
        "http://localhost:34700"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "spire-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email",
        "acr"
      ]
    },
    {
      "clientId": "spire-review-worker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-worker-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:34000/wk/auth/callback",
        "http://localhost:39285/wk/auth/callback",
        "http://localhost:34082/wk/auth/callback",
        "http://localhost:39282/wk/auth/callback",
        "http://localhost:34700/wk/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:34000",
        "http://localhost:39285",
        "http://localhost:34700"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "spire-review-worker",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email",
        "acr"
      ]
    }
  ]
}
